{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:terranova:oal-001:slice-2-run:1.0",
  "title": "OAL-001 Slice 2 Historical Replay Trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slice_id",
    "run_id",
    "issue",
    "mode",
    "execution_mode",
    "branch",
    "base_sha",
    "source_state",
    "source_manifest_sha256",
    "contract_sha256",
    "fixture",
    "replay_count",
    "replays",
    "replay_digest",
    "process_events",
    "process_observations",
    "efficiency_score",
    "on_reject",
    "final_human_gate",
    "external_mutation_count",
    "promotion_authorized",
    "git_status",
    "not_actions",
    "overall_verdict"
  ],
  "properties": {
    "schema_version": {"const": "OAL-1.0"},
    "slice_id": {"const": "OAL-001-SLICE-2"},
    "run_id": {"type": "string", "pattern": "^OAL-001-S2-[A-F0-9]{16}$"},
    "issue": {"const": 99},
    "mode": {"const": "historical_offline_replay"},
    "execution_mode": {"const": "combined"},
    "branch": {"type": "string", "pattern": "^codex/observatory-selfmod-.+$"},
    "base_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "source_state": {"enum": ["clean_commit", "working_tree_manifest"]},
    "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_set_id", "sha256", "projection_class", "raw_source_committed", "source_locator_committed"],
      "properties": {
        "fixture_set_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "projection_class": {"const": "connector_verified_at_admission"},
        "raw_source_committed": {"const": false},
        "source_locator_committed": {"const": false}
      }
    },
    "replay_count": {"const": 3},
    "replays": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "object"}
    },
    "replay_digest": {"$ref": "#/$defs/sha256"},
    "process_events": {
      "type": "array",
      "items": {"$ref": "#/$defs/process_event"}
    },
    "process_observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interruption_count", "restart_count"],
      "properties": {
        "interruption_count": {"type": "integer", "minimum": 0},
        "restart_count": {"type": "integer", "minimum": 0}
      }
    },
    "efficiency_score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "reason"],
      "properties": {
        "enabled": {"const": false},
        "reason": {"const": "no_isolated_measurement_basis"}
      }
    },
    "on_reject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_action", "rollback", "evidence", "process_event", "final_report", "promotion_authorized"],
      "properties": {
        "candidate_action": {"const": "terminate"},
        "rollback": {"const": "required"},
        "evidence": {"const": "required"},
        "process_event": {"const": "required"},
        "final_report": {"const": "required"},
        "promotion_authorized": {"const": false}
      }
    },
    "final_human_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "trigger", "required"],
      "properties": {
        "mode": {"const": "at_most_once"},
        "trigger": {"const": "proposed_action_requires_human_authority"},
        "required": {"type": "boolean"}
      }
    },
    "external_mutation_count": {"const": 0},
    "promotion_authorized": {"const": false},
    "git_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "unchanged", "clean_worktree"],
      "properties": {
        "before": {"type": "string", "not": {"pattern": "(^|\\n)## "}},
        "after": {"type": "string", "not": {"pattern": "(^|\\n)## "}},
        "unchanged": {"type": "boolean"},
        "clean_worktree": {"type": "boolean"}
      }
    },
    "not_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "overall_verdict": {"enum": ["PASS", "PASS_PREPARED", "REJECT"]}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "process_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reason", "stage", "timestamp"],
      "properties": {
        "type": {"enum": ["interruption", "restart"]},
        "reason": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    }
  }
}
