# Keep repository text files stable across Windows, macOS and Linux.
* text=auto eol=lf

# Common text formats used by this repository.
*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Windows command scripts are the exception.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary artifacts must never be line-ending normalized.
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.webp binary
*.zip binary
